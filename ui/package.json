{
  "name": "chronos-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently --names \"ui,server\" --prefix-colors \"cyan,yellow\" \"vite\" \"cargo run -p chronos-server --manifest-path ../engine/Cargo.toml\"",
    "dev:ui": "vite",
    "build": "tsc && vite build",
    "build:itch": "tsc && vite build --base=./ --outDir dist-itch",
    "preview": "vite preview",
    "preview:itch": "vite preview --outDir dist-itch",
    "build:wasm": "cd ../engine && wasm-pack build chronos-wasm --target web --out-dir ../../ui/src/wasm",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "validate:worlds": "python ../scripts/validate_worlds.py"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.9",
    "concurrently": "^10.0.4",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-wasm": "^3.3.0",
    "vitest": "^4.1.10"
  }
}
